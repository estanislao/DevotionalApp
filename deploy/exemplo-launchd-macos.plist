<?xml version="1.0" encoding="UTF-8"?>
<!-- EXEMPLO. Agenda no macOS a cópia diária dos backups, às 04:30 (depois do backup da VM, às 03:30).
     Nada aqui é instalado sozinho. Para ligar:
       1) troque SEU_USUARIO e o caminho do script abaixo;
       2) cp exemplo-launchd-macos.plist ~/Library/LaunchAgents/br.trilhadefe.backup.plist
       3) launchctl load ~/Library/LaunchAgents/br.trilhadefe.backup.plist
     Para desligar: launchctl unload ~/Library/LaunchAgents/br.trilhadefe.backup.plist
     O Mac precisa estar ligado nesse horário; se estiver dormindo, o launchd roda quando acordar. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>br.trilhadefe.backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/SEU_USUARIO/Agentic/DevotionalApp/deploy/copiar-backup-para-fora.sh</string>
    <string>diana-server</string>
    <string>/Users/SEU_USUARIO/Backups/trilhadefe</string>
  </array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>/tmp/trilhadefe-backup.log</string>
  <key>StandardErrorPath</key><string>/tmp/trilhadefe-backup.log</string>
</dict>
</plist>
