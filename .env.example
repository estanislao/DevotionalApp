# Copie para ".env" e preencha antes de subir (nunca comite o .env de verdade)

# Qualquer string longa e aleatória (mínimo 16 caracteres) — assina o cookie de sessão.
# O app se recusa a iniciar se isso estiver vazio ou curto. Gere uma com:
#   openssl rand -hex 32
SESSION_SECRET=

# Membros da família que podem logar: Nome:PIN, separados por vírgula.
# Escreva ":admin" depois do PIN de quem pode publicar devocionais.
SEED_MEMBERS=Membro 1:1234:admin,Membro 2:2345,Membro 3:3456,Membro 4:4567

# Deixe como está em produção (HTTPS via Caddy). Só mude para 0 ao testar em http://localhost.
COOKIE_SECURE=1

# --- Opcional: "Esqueci meu PIN" por e-mail (API da Brevo) ---
# Sem BREVO_API_KEY e MAIL_FROM o link some da tela de login e só o admin redefine PINs em /admin/membros.
# MAIL_FROM precisa ser um remetente verificado na sua conta Brevo.
PUBLIC_URL=https://trilhadefe.app
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Portal de Devocionais
