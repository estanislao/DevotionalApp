# Copie para ".env" e preencha antes de subir (nunca comite o .env de verdade)

# Qualquer string longa e aleatória (mínimo 16 caracteres) — assina o cookie de sessão.
# O app se recusa a iniciar se isso estiver vazio ou curto. Gere uma com:
#   openssl rand -hex 32
SESSION_SECRET=

# Conta do administrador (criada no primeiro boot; depois a senha pode ser trocada pela interface).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# Deixe como está em produção (HTTPS via Caddy). Só mude para 0 ao testar em http://localhost.
COOKIE_SECURE=1

# Endereço público, usado nos links dos e-mails.
PUBLIC_URL=https://trilhadefe.app

# --- Opcional: e-mails (API da Brevo) — "Esqueci minha senha", aviso de inscrição nova e de aprovação ---
# Sem BREVO_API_KEY e MAIL_FROM o app funciona, mas sem e-mails. MAIL_FROM precisa ser remetente verificado na Brevo.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Portal de Devocionais
